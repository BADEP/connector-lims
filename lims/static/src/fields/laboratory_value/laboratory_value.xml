   <t t-name="lims.LaboratoryValueField" owl="1">
        <div t-ref="this.rootRef">
            <t t-if="this.props.readonly">
                <ul t-if="this.type === 'multiselection-check'">
                    <li
                        t-foreach="this.value"
                        t-as="option"
                        t-key="option_index"
                        t-att-class="this.value[option] ? 'selected' : 'not-selected'"
                    >
                        <span class="ps-1" t-out="option" />
                    </li>
                </ul>
                <CheckBox
                    id="this.props.id"
                    value="this.value"
                    className="'d-inline-block'"
                    disabled="this.props.readonly"
                    onChange.bind="this.onChangeBoolean"
                    t-elif="this.type==='boolean'"
                />
                <TagsList
                    t-elif="this.type === 'multiselection'"
                    tags="this.value.map((x) => ({text: x}))"
                    tagLimit="this.value.length"
                    t-slot-scope="tag"
                >
                    <BadgeTag text="tag.text" />
                </TagsList>
                <span
                    t-attf-class="o_lims_laboratory_value_{{this.type}}"
                    t-out="this.value"
                    t-else=""
                />
            </t>
            <t t-else="">
                <input
                    t-if="this.type === 'float'"
                    t-att-id="this.props.id"
                    t-ref="this.numpadDecimalRef"
                    inputmode="decimal"
                    class="o_input"
                    autocomplete="off"
                />
                <textarea
                    class="o_input"
                    t-att-id="this.props.id"
                    t-ref="this.textInputRef"
                    t-att-rows="1"
                    t-if="this.type === 'text'"
                />
                <input
                    class="o_input"
                    t-att-class="{
                    'o_field_translate': this.isTranslatable,
                    'o_field_placeholder': this.hasDynamicPlaceholder
                }"
                    t-att-id="this.props.id"
                    type="text"
                    autocomplete="off"
                    t-ref="this.charInputRef"
                    t-if="this.type === 'char'"
                />
                <CheckBox
                    id="this.props.id"
                    value="this.value"
                    className="'d-inline-block'"
                    disabled="this.props.readonly"
                    onChange.bind="this.onChangeBoolean"
                    t-elif="this.type==='boolean'"
                />
                <input
                    t-ref="this.dateInputRef"
                    type="text"
                    t-att-id="this.props.id"
                    autocomplete="off"
                    t-att-placeholder="this.props.placeholder"
                    data-field="dateInput"
                    t-on-input="this.onDateInput"
                    t-on-change="this.onDateChange"
                    t-att-value="this.formattedDate || this.state.value"
                    t-on-focus="() => this.picker.activeInput = 'dateInput'"
                    t-elif="this.type === 'datetime' || this.type === 'date'"
                />
                <ul t-if="this.type === 'multiselection-check'">
                    <li
                        t-foreach="this.value"
                        t-as="option"
                        t-key="option_index"
                        t-att-class="this.value[option] ? 'selected' : 'not-selected'"
                        t-on-click="() => this.onChangeMultiSelectionCheck(option)"
                    >
                        <span class="ps-1" t-out="option" />
                    </li>
                </ul>
                <SelectMenu
                    t-if="this.type === 'selection'"
                    autoSort="false"
                    class="'border-0'"
                    menuClass="'o_field_selection_menu w-auto'"
                    value="this.value"
                    choices="this.props.record.data[this.props.name].selection.map((x)=>({value: x, label:x}))"
                    onSelect.bind="this.onChangeSelection"
                    id="this.props.id"
                    searchable="true"
                />
                <div
                    t-ref="this.multiselectionInputRef"
                    t-if="this.type === 'multiselection'"
                    class="o_multiselection_input"
                >
                    <SelectMenu
                        autoSort="false"
                        class="'border-0'"
                        multiSelect="true"
                        menuClass="'o_field_selection_menu w-auto'"
                        value="this.value"
                        choices="this.props.record.data[this.props.name].selection.map((x)=>({value: x, label:x}))"
                        onSelect.bind="this.onChangeSelection"
                        id="this.props.id"
                        searchable="true"
                    />
                </div>
            </t>
        </div>
    </t>
</templates>
