    <t t-name="lims.LaboratoryEvaluationField" owl="1">
        <div>
            <span class="text-success fw-bold" t-if="this.value === 'valid'">=</span>
            <i class="oi text-warning" data-icon="keyboard_arrow_down" t-elif="this.value === 'min_warning'" />
            <i class="oi text-danger" data-icon="keyboard_double_arrow_down" t-elif="this.value === 'min'" />
            <i class="oi text-warning" data-icon="keyboard_arrow_up" t-elif="this.value === 'max_warning'" />
            <i class="oi text-danger" data-icon="keyboard_double_arrow_up" t-elif="this.value === 'max'" />
        </div>
    </t>
</templates>
